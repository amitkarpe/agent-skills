#!/usr/bin/env bash
set -euo pipefail
umask 0002

ROOT="${AGENT_WEB_WWW:-/opt/agent-web/www}"

usage() {
  cat <<'EOF'
Usage:
  agent-web-www init
  agent-web-www rebuild-index
  agent-web-www validate
  agent-web-www show-config

Purpose:
  Manage the canonical /www report tree under /opt/agent-web/www.
EOF
}

init_tree() {
  mkdir -p "$ROOT/reports" "$ROOT/archive" "$ROOT/assets" "$ROOT/context" "$ROOT/.meta"
}

rebuild_index() {
  init_tree
  python3 - "$ROOT" <<'PY'
import json
import html
import sys
from pathlib import Path

root = Path(sys.argv[1])
items = []
for p in root.glob("reports/*/*/*/*/manifest.json"):
    try:
        data = json.loads(p.read_text())
    except Exception:
        continue
    data["_manifest"] = str(p)
    items.append(data)
items.sort(key=lambda x: x.get("created", ""), reverse=True)

cards = []
for item in items[:300]:
    title = html.escape(item.get("title", "untitled"))
    typ = html.escape(item.get("type", "general"))
    created = html.escape(item.get("created", ""))
    url = html.escape(item.get("url", "#"))
    owner = html.escape(item.get("owner", "unknown"))
    evidence = html.escape(item.get("evidence", ""))
    cards.append(
        f"<article class='card'><div class='meta'>{created} · {typ} · {owner}</div>"
        f"<h2><a href='{url}'>{title}</a></h2><code>{evidence}</code></article>"
    )
body = "\n".join(cards) or "<article class='card'><h2>No reports yet</h2></article>"

(root / "index.html").write_text(f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Agent Web WWW Reports</title>
<style>
:root{{color-scheme:dark;--bg:#090b10;--panel:#101722;--line:#273449;--text:#edf3ff;--muted:#95a6c0;--blue:#6aa6ff}}
body{{margin:0;background:radial-gradient(circle at 12% 0,#17243a,#090b10 36%);color:var(--text);font:14px/1.5 system-ui,-apple-system,Segoe UI,Arial,sans-serif}}
main{{max-width:1280px;margin:0 auto;padding:24px}}a{{color:var(--blue);text-decoration:none}}a:hover{{text-decoration:underline}}
.hero,.card{{border:1px solid var(--line);background:linear-gradient(180deg,#151f2e,#0d131d);border-radius:14px;box-shadow:0 16px 50px rgba(0,0,0,.28)}}
.hero{{padding:20px;margin-bottom:14px}}h1{{margin:0 0 6px;font-size:30px}}.hero p,.meta,code{{color:var(--muted)}}
.grid{{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:12px}}.card{{padding:14px}}.card h2{{font-size:17px;margin:7px 0 10px}}
code{{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;background:#0b1018;border:1px solid #202b3c;border-radius:7px;padding:5px 7px}}
</style></head><body><main>
<section class="hero"><h1>Agent Web WWW Reports</h1><p>Canonical report index for deterministic agent-published HTML. Filesystem root: /opt/agent-web/www · URL root: /www/</p></section>
<section class="grid">{body}</section>
</main></body></html>
""")
PY
  chmod g+rw "$ROOT/index.html" 2>/dev/null || true
}

validate_tree() {
  init_tree
  test -d "$ROOT/reports"
  test -d "$ROOT/archive"
  test -d "$ROOT/assets"
  test -d "$ROOT/context"
  python3 - "$ROOT" <<'PY'
import json
import sys
from pathlib import Path
root = Path(sys.argv[1])
bad = 0
for p in root.glob("reports/*/*/*/*/manifest.json"):
    try:
        data = json.loads(p.read_text())
    except Exception as exc:
        print(f"bad_json {p}: {exc}")
        bad += 1
        continue
    target = p.parent / "index.html"
    if not target.exists():
        print(f"missing_index {target}")
        bad += 1
print(f"manifests_checked={len(list(root.glob('reports/*/*/*/*/manifest.json')))}")
raise SystemExit(1 if bad else 0)
PY
}

case "${1:-}" in
  init) init_tree ;;
  rebuild-index) rebuild_index ;;
  validate) validate_tree ;;
  show-config)
    printf 'root=%s\n' "$ROOT"
    printf 'url=http://192.168.0.9/www/\n'
    ;;
  -h|--help|"") usage ;;
  *) printf 'agent-web-www: unknown command: %s\n' "$1" >&2; usage >&2; exit 2 ;;
esac
