{
 "schema_version": 1,
 "note": "Maps discovered resource types to a diagram role. role=show draws a node; fold lists the resource in coverage.omitted with the fold reason. config may be one type or a list. icon_key must be in native-aws4-map.json lookup/direct_shapes; native_icon must be an mxgraph.aws4 resourceIcon name. name_folds fold AWS-managed or landing-zone resources by name, whatever their type. Unknown types are drawn as label-only cards and reported, never dropped.",
 "tiers": [
  "edge",
  "compute",
  "integration",
  "data",
  "delivery",
  "security",
  "operations"
 ],
 "tier_labels": {
  "edge": "Entry and edge",
  "compute": "Compute",
  "integration": "Integration and events",
  "data": "Data and storage",
  "delivery": "Build and delivery",
  "security": "Security and identity",
  "operations": "Operations and monitoring"
 },
 "fold_reasons": {
  "network": "network plumbing; draw the VPC or subnet as a boundary by hand when it matters",
  "config": "configuration detail of its parent resource",
  "iam-detail": "IAM detail folded into its role",
  "dns-record": "DNS record folded into its hosted zone",
  "platform": "account baseline, landing-zone or AWS-managed resource, not part of the workload"
 },
