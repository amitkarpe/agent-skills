  "id": "aws-3-tier-demo-v2",
  "name": "AWS 3-Tier Demo",
  "title": "Demo AWS 3-Tier Application Architecture",
  "subtitle": "Highly available web application across two Availability Zones",
  "alt_text": "Highly available AWS three-tier application with Route 53 and CloudFront ingress, load-balanced EC2 application tiers in two Availability Zones, and a Multi-AZ RDS database tier.",
  "long_description": "Users reach Route 53 and CloudFront before traffic enters an Application Load Balancer. Two private application subnets host EC2 instances across separate Availability Zones, while private database subnets contain the RDS primary and standby. NAT gateways provide controlled egress, S3 supplies static content, and CloudWatch receives operational telemetry.",
  "architecture_type": "application",
  "audience": "Application teams, cloud engineers, and architecture reviewers",
